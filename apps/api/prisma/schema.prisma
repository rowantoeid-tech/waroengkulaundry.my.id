// Prisma schema — sinkron dengan database/schema.sql
// Jalankan schema.sql di PostgreSQL, lalu: npm run prisma:generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  kasir
  operator_laundry
  gudang

  @@map("user_role")
}

enum StockMovementType {
  masuk
  keluar
  penyesuaian
  retur_masuk
  retur_keluar

  @@map("stock_movement_type")
}

enum PaymentMethod {
  tunai
  transfer
  qris
  hutang

  @@map("payment_method")
}

enum SaleStatus {
  draft
  selesai
  dibatalkan

  @@map("sale_status")
}

enum LaundryOrderStatus {
  terima
  cuci
  kering
  setrika
  siap_ambil
  diambil
  dibatalkan

  @@map("laundry_order_status")
}

enum LaundryServiceUnit {
  kg
  pcs
  paket

  @@map("laundry_service_unit")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  address   String?
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users         User[]
  customers     Customer[]
  productStocks ProductStock[]
  stockMovements StockMovement[]
  sales         Sale[]
  laundryOrders LaundryOrder[]

  @@map("branches")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(120)
  phone        String?   @db.VarChar(20)
  role         UserRole  @default(kasir)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  code      String?  @unique @db.VarChar(30)
  name      String   @db.VarChar(120)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("customers")
}

model ProductCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(80)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("product_categories")
}

model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  sku           String   @unique @db.VarChar(50)
  barcode       String?  @db.VarChar(50)
  name          String   @db.VarChar(150)
  unit          String   @default("pcs") @db.VarChar(20)
  purchasePrice Decimal  @default(0) @map("purchase_price") @db.Decimal(14, 2)
  sellPrice     Decimal  @default(0) @map("sell_price") @db.Decimal(14, 2)
  minStock      Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks   ProductStock[]
  saleItems SaleItem[]

  @@map("products")
}

model ProductStock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@map("product_stocks")
}

model LaundryService {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String             @unique @db.VarChar(30)
  name            String             @db.VarChar(100)
  unit            LaundryServiceUnit @default(kg)
  basePrice       Decimal            @default(0) @map("base_price") @db.Decimal(14, 2)
  estimatedHours  Int?               @map("estimated_hours")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems LaundryOrderItem[]

  @@map("laundry_services")
}

model LaundryOrder {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String             @map("branch_id") @db.Uuid
  orderNumber    String             @map("order_number") @db.VarChar(30)
  customerId     String?            @map("customer_id") @db.Uuid
  customerName   String?            @map("customer_name") @db.VarChar(120)
  customerPhone  String?            @map("customer_phone") @db.VarChar(20)
  status         LaundryOrderStatus @default(terima)
  promisedAt     DateTime?          @map("promised_at") @db.Timestamptz(6)
  pickedUpAt     DateTime?          @map("picked_up_at") @db.Timestamptz(6)
  subtotal       Decimal            @default(0) @db.Decimal(14, 2)
  discount       Decimal            @default(0) @db.Decimal(14, 2)
  total          Decimal            @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal            @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentMethod  PaymentMethod?     @map("payment_method")
  notes          String?
  receivedBy     String?            @map("received_by") @db.Uuid
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  LaundryOrderItem[]
  statusLogs LaundryStatusLog[]

  @@unique([branchId, orderNumber])
  @@map("laundry_orders")
}

model LaundryOrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  itemLabel  String?  @map("item_label") @db.VarChar(80)
  quantity   Decimal  @db.Decimal(10, 3)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   LaundryOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service LaundryService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@map("laundry_order_items")
}

model LaundryStatusLog {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String              @map("order_id") @db.Uuid
  fromStatus LaundryOrderStatus? @map("from_status")
  toStatus   LaundryOrderStatus  @map("to_status")
  notes      String?
  changedBy  String?             @map("changed_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("laundry_status_logs")
}

model Sale {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  invoiceNumber String        @map("invoice_number") @db.VarChar(30)
  customerId    String?       @map("customer_id") @db.Uuid
  status        SaleStatus    @default(selesai)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(tunai) @map("payment_method")
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  notes         String?
  cashierId     String?       @map("cashier_id") @db.Uuid
  soldAt        DateTime      @default(now()) @map("sold_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  SaleItem[]

  @@unique([branchId, invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  movementType   StockMovementType @map("movement_type")
  quantity       Decimal           @db.Decimal(12, 3)
  quantityBefore Decimal           @map("quantity_before") @db.Decimal(12, 3)
  quantityAfter  Decimal           @map("quantity_after") @db.Decimal(12, 3)
  referenceType  String?           @map("reference_type") @db.VarChar(40)
  referenceId    String?           @map("reference_id") @db.Uuid
  notes          String?
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}
