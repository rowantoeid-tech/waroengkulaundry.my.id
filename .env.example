# Salin ke .env lalu isi nilai sebenarnya
# cp .env.example .env

# Database (PostgreSQL disarankan)
DATABASE_URL=postgresql://user:password@localhost:5432/waroengkulaundry

# API
API_PORT=3000
API_BASE_URL=http://localhost:3000
JWT_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter

# Web (Vite / Next.js — sesuaikan saat setup)
VITE_API_URL=http://localhost:3000/api

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
